# API
CLIPBOARD_MATE_HOST=127.0.0.1
CLIPBOARD_MATE_PORT=43120
CLIPBOARD_MATE_DB_PATH=./data/clipboard-mate.sqlite
CLIPBOARD_MATE_HISTORY_LIMIT=250
CLIPBOARD_MATE_MAX_TEXT_BYTES=262144
CLIPBOARD_MATE_ALLOWED_ORIGIN=

# Docker Compose host settings. Keep the API on loopback when publishing it
# through a reverse proxy or Cloudflare Tunnel.
CLIPBOARD_MATE_BIND_ADDRESS=127.0.0.1
CLIPBOARD_MATE_BIND_PORT=43120
CLIPBOARD_MATE_IMAGE=clipboard-mate-api:local
