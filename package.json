{
  "name": "clipboard-mate",
  "version": "0.1.0",
  "private": true,
  "description": "A deliberate, shared clipboard relay for iPhone, Windows, and macOS.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:api": "pnpm --filter @clipboard-mate/api dev",
    "dev:desktop": "pnpm --filter @clipboard-mate/desktop dev",
    "device:create": "pnpm --filter @clipboard-mate/api device:create",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}

