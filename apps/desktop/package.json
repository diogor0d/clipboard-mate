{
  "name": "@clipboard-mate/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Clipboard Mate desktop tray client.",
  "author": "Diogo",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "package:dir": "pnpm run build && electron-builder --config electron-builder.yml --dir",
    "package:mac": "pnpm run build && electron-builder --config electron-builder.yml --mac dmg zip --x64 --arm64",
    "package:win": "pnpm run build && electron-builder --config electron-builder.yml --win nsis --x64",
    "postinstall": "install-electron",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@clipboard-mate/contracts": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.11.1",
    "electron-vite": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "zod": "^4.0.0"
  }
}
